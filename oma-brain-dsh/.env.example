OMA_API_URL=http://127.0.0.1:38080
# Must match the backend code_session.brain_claim_token_file contents.
OMA_BRAIN_CLAIM_TOKEN=
OMA_BRAIN_CLAIM_CONCURRENCY=4
OMA_BRAIN_MAX_SESSIONS=8
# CCRv2 heartbeats renew the 20-second Brain worker lease.
OMA_CCR_HEARTBEAT_INTERVAL_MS=6000
OMA_CCR_HEARTBEAT_TIMEOUT_MS=5000
OMA_CCR_HEARTBEAT_JITTER_FRACTION=0.1
OMA_CCR_HEARTBEAT_MAX_FAILURES=0
OMA_CCR_HEARTBEAT_MAX_AUTH_FAILURES=10
# Optional activity keep_alive events, matching superduck's opt-in switch.
CLAUDE_CODE_REMOTE_SEND_KEEPALIVES=0
