{
  "name": "oma-brain-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "build:executable": "bun scripts/build-executable.ts",
    "start": "bun src/main.ts",
    "restart": "bash scripts/restart.sh",
    "test": "bun test --timeout 15000",
    "verify": "bun scripts/verify.ts",
    "verify:executable": "bun scripts/verify.ts --executable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@ai-sdk/provider": "4.0.29",
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-otel": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-time-context": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.57.2",
    "@opentelemetry/exporter-logs-otlp-http": "0.57.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-logs": "0.57.2",
    "@opentelemetry/sdk-metrics": "1.30.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
