+func brainCoverage(scenario string) string {
+	if scenario == "chat.brain-dsh-live" {
+		return "Coverage: real model through explicitly configured OMA, production backend HTTP, PostgreSQL, Redis, three-node NATS and Docker MCP. Bun embeds the original dsh loop. Public allow confirmation, history restoration after SIGKILL and inflight tool crash are checked. Parameter replacement is injected as a CCRv2 reply over JetStream because public updated_input returns HTTP 400. Its private turn completes, but the public approval remains pending until session termination; public approval editing is not verified. No upstream responses are scripted.\n\n"
+	}
+	return "Coverage: public API, production Runner, real Brain process, PostgreSQL, Redis, JetStream and sandbox MCP with actual FUSE mounts. skills-loading additionally runs the real Claude Worker. Only the upstream model is scripted. See required proofs for mode-specific allocation and loading behavior. Real-model Skill selection, cloud allocation, network partitions and performance are not verified.\n\n"
+}
